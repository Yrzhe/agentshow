{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentshow",
  "compatibility_date": "2026-01-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",

  // Think 内置 workers-ai-provider，getModel() 返回模型 id 字符串即可走这个绑定。
  "ai": { "binding": "AI" },

  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // 所有请求都先过 Worker，鉴权之后再由 Worker 转发静态资源。
    //
    // 曾经写成 ["/agents/*"]，那样只有 agent 端点过 Worker，首页和 JS bundle
    // 由静态资源直接命中，鉴权代码根本不执行 —— 部署后实测 / 返回 200。
    // 布尔 true 是唯一能让闸覆盖全部路径的写法。
    "run_worker_first": true
  },

  "durable_objects": {
    "bindings": [
      { "class_name": "AgentDO", "name": "AgentDO" },
      { "class_name": "ProjectDO", "name": "ProjectDO" }
    ]
  },

  // ProjectDO 现在就进 migration，Task 2 才填内容 —— 改 migration tag 比多写三行麻烦。
  "migrations": [{ "new_sqlite_classes": ["AgentDO", "ProjectDO"], "tag": "v1" }]
}
